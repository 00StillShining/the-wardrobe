# THE WARDROBE — environment variables (names + descriptions only; never commit real values)

# Serve the rebuild shell instead of the legacy app (any value other than "1" = legacy).
# In dev you can also append ?revamp to the URL (sticky for the browser session).
VITE_WARDROBE_REVAMP=

# Show sample/demo data surfaces (sample receipts, sample price listings) outside DEV builds.
# Accepted value: exactly "true" (see src/config/runtime.ts). Anything else is off.
# Production must ship with this unset — providers that aren't configured stay fail-closed.
VITE_WARDROBE_DEMO=

# Supabase project URL (public), e.g. https://<project-ref>.supabase.co.
# Backend mode is 'supabase' only when BOTH this and the anon key are set;
# otherwise the app runs local-first (and a PROD build renders fail-closed).
VITE_SUPABASE_URL=

# Supabase anon/publishable key (public — authorization is enforced by RLS).
# NEVER put a service-role key or any secret in the browser environment.
VITE_SUPABASE_ANON_KEY=
